#!/usr/bin/env bash
# Record whatever macOS is playing (Spotify, a browser, any app) to a WAV until you press Enter.
#
#   utils/record-system-audio [out.wav]      default: ./system-audio-<YYYYmmdd-HHMMSS>.wav
#
# Uses a Core Audio process tap (macOS 14.2+), so no BlackHole routing is needed. The first run
# asks for "System Audio Recording" permission for your terminal app. Builds the recorder
# (utils/system-audio-recorder, Rust) on first use and whenever its source changes.
set -euo pipefail

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'
  exit 0
fi

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
crate="$here/system-audio-recorder"
bin="$crate/target/release/system-audio-recorder"

if [[ ! -x "$bin" || -n "$(find "$crate/src" "$crate/Cargo.toml" -newer "$bin" 2>/dev/null | head -n 1)" ]]; then
  echo "Building the recorder…" >&2
  cargo build --release --quiet --manifest-path "$crate/Cargo.toml"
fi

exec "$bin" "${1:-system-audio-$(date +%Y%m%d-%H%M%S).wav}"
